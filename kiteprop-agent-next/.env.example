# Clave de la API de Claude (platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar para el agente
CLAUDE_MODEL=claude-sonnet-5

# Clave de API de KiteProp (KiteProp -> Configuracion -> API Keys -> Crear nueva clave)
KITEPROP_API_KEY=kp_...

# URL del servidor MCP de KiteProp (no suele cambiar)
KITEPROP_MCP_URL=https://mcp.kiteprop.com/mcp

# Nombre de la inmobiliaria, se usa en el system prompt y en la UI
AGENCY_NAME=Mi Inmobiliaria

# Next.js carga automaticamente .env.local (no hace falta declarar PORT:
# "next dev -p 4000" o "PORT=4000 next start" si queres otro puerto)
