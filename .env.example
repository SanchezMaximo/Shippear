# Copiá este archivo a .env.local para desarrollo, y cargá las mismas variables
# en el proyecto de Vercel para producción.

# --- Modelo (AI Gateway de Vercel) ---
# En local, `vercel env pull` o un token de gateway. En Vercel se inyecta solo.
AI_GATEWAY_API_KEY=

# --- KiteProp ---
# Tu API key personal de KiteProp; empieza con `kp_`.
# El MCP la recibe como header `X-API-Key`; el cliente REST, como `Authorization: Bearer`.
KITEPROP_API_KEY=
# Base de la API REST, sin barra final. Ej: https://api.kiteprop.com/v1
# Solo la usa build_proposal para refrescar precios; las búsquedas van por el MCP.
KITEPROP_API_URL=
# Endpoint del MCP. Opcional: por defecto https://mcp.kiteprop.com/mcp
KITEPROP_MCP_URL=

# --- Modo demo (sin credenciales de KiteProp) ---
# `1` hace que el agente genere propiedades SIMULADAS con el LLM en vez de consultar el CRM.
# Apagado por defecto. Todo lo que sale (chat, PDF, email) queda marcado como simulado.
# No lo dejes encendido con asesores reales: el flujo termina en un mail a un cliente.
KIGENT_DEMO=

# --- Dictado por voz en el chat (ElevenLabs Scribe) ---
# Opcional: sin esta variable el botón de micrófono avisa y el chat sigue andando.
# El browser nunca ve la key: /api/scribe-token emite un token de un solo uso.
ELEVENLABS_API_KEY=

# --- Envío de la propuesta por email (Resend) ---
RESEND_API_KEY=
# Remitente con dominio verificado en Resend.
PROPOSAL_FROM_EMAIL="Inmobiliaria <propuestas@tudominio.com>"
